{
  "name": "@srdjan/memdb-api",
  "imports": {
    "@memdb/core/": "../memdb-core/src/",
    "@std/http/": "https://deno.land/std@0.224.0/http/",
    "@std/path": "https://deno.land/std@0.224.0/path/mod.ts",
    "@memdb/turso/": "../memdb-turso/src/"
  },
  "tasks": {
    "dev": "deno run -A --watch=src src/main.ts",
